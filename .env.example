BOT_TOKEN=123456789:replace_with_your_botfather_token

# API-ключи Telegram. Публичные подходят для теста, но лучше получить
# собственные на https://my.telegram.org (API development tools).
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627

# SOCKS5/HTTP-прокси для Telegram (приоритетнее MTProto).
# Пример для локального Tor: socks5://127.0.0.1:9050
TELEGRAM_PROXY_URL=

# MTProto-прокси (не HTTP). Можно указать одной ссылкой — она главнее полей.
# Пример: tg://proxy?server=127.0.0.1&port=1443&secret=dd9c...
TELEGRAM_MT_PROXY=
# Либо отдельными полями. Если не нужен — оставьте пустыми.
TELEGRAM_MT_PROXY_SERVER=
TELEGRAM_MT_PROXY_PORT=
TELEGRAM_MT_PROXY_SECRET=

# Как часто цикл парсера проверяет объявления (в секундах).
# 1 = цикл крутится каждую секунду, но реальные запросы к Авито всё равно
# разнесены паузой REQUEST_DELAY_SECONDS, чтобы не получить блокировку.
CHECK_INTERVAL_SECONDS=1

# Сколько страниц читать при первом запуске и при обычной проверке.
INITIAL_PAGES=1
CHECK_PAGES=1

# Пауза между реальными запросами к Avito (в секундах), чтобы не было всплесков.
REQUEST_DELAY_SECONDS=10

# Максимум новых объявлений за один цикл (остальные придут в следующий раз).
MAX_NEW_PER_CHECK=100

# Открывать карточку нового объявления ради полного описания, продавца и рейтинга.
# false = меньше нагрузки и быстрее проверки.
FETCH_DETAILS=false

# Нужен, если Avito отвечает 403/429/439 с вашего IP.
# Примеры:
# AVITO_PROXY_URL=http://user:password@host:port
# AVITO_PROXY_URL=socks5://user:password@host:port
AVITO_PROXY_URL=
# Несколько прокси через запятую — клиент и браузер ротируют их при блокировке.
# AVITO_PROXY_URLS=http://user:pass@host1:port,socks5://user:pass@host2:port
AVITO_PROXY_URLS=

# Файл со списком прокси: по одному на строку, # — комментарий.
# Браузер и HTTP-запросы будут ротировать их при блокировке.
# AVITO_PROXY_FILE=data/proxies.txt
AVITO_PROXY_FILE=

# Отдельный прокси только для браузера (необязательно). Если пусто —
# берётся первый из AVITO_PROXY_URLS/AVITO_PROXY_URL.
AVITO_BROWSER_PROXY=

# Перезапускать браузер на следующем прокси из списка при проверке IP.
# false — оставаться на текущем IP и ждать, пока проверку пройдут вручную.
AVITO_ROTATE_ON_BLOCK=true

# Первая пауза после блокировки (минуты). Дальше удваивается:
# 10 → 20 → 40 → 80 → 120 (максимум 2 часа).
AVITO_BLOCK_PAUSE_MINUTES=10

# Если прокси не отвечает или блокирует — пробовать прямой запрос.
AVITO_PROXY_FALLBACK_DIRECT=true

# Таймаут одного запроса к Avito (секунды). Для Tor лучше 45-60.
AVITO_TIMEOUT_SECONDS=45

# Необязательно: числовой ID города Avito для JSON API (Москва = 637640).
# Если пусто, бот определяет город по IP или берёт locationId из ссылки поиска.
AVITO_LOCATION_ID=

# Необязательно: готовый Cookie из браузера (одной строкой).
AVITO_COOKIE=

# Загрузка Авито через настоящий браузер (Playwright) — проходит JS-антибот.
AVITO_USE_BROWSER=true
# true = без окна браузера (бот работает как консольное приложение).
AVITO_BROWSER_HEADLESS=false
AVITO_BROWSER_PROFILE=data/browser_profile
# Искать по всей России, а не только в городе из ссылки.
AVITO_ALL_RUSSIA=true
# Файл с паузой после блокировки: переживает перезапуск бота.
AVITO_STATE_PATH=data/avito_state.json
# Как часто автообновлять открытую страницу поиска (секунды).
# 20 сек — новый лот появляется почти сразу. Чаще 15 сек не надо:
# Авито блокирует IP за частые запросы.
AVITO_RELOAD_SECONDS=20
# Показывать объявления, опубликованные за последние N часов (точное время
# берётся из карточки: «1 час назад», «сегодня в 21:14»).
AVITO_FRESH_HOURS=24

DB_PATH=data/bot.db

# Файл сессии Telethon (без расширения .session).
SESSION_PATH=data/bot

LOG_LEVEL=INFO
